{
  "Authentication": {
    "Authority": "http://172.28.225.131:8080/realms/company-dev",
    "RequireHttpsMetadata": false,
    "ClockSkewSeconds": 0
  },

  "Swagger": {
    "Title": "API Gateway",
    "Version": "v1",
    "DownstreamDocs": [
      {
        "Name": "Customer API",
        "Key": "customer",
        "SwaggerJsonPathOnGateway": "/swagger-json/customer/v1/swagger.json"
      },
      {
        "Name": "Product API",
        "Key": "product",
        "SwaggerJsonPathOnGateway": "/swagger-json/product/v1/swagger.json"
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      // ================= CUSTOMER =================
      "customer-service": {
        "ClusterId": "customer-api",
        "Match": { "Path": "/customer-service/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/customer-service" }
        ],
        "AuthorizationPolicy": "GatewayAuthenticated"
      },

      "swagger-customer": {
        "ClusterId": "customer-api",
        "Match": { "Path": "/swagger-json/customer/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },

      // ================= PRODUCT =================
      "product-service": {
        "ClusterId": "product-api",
        //"AuthorizationPolicy": "GatewayAuthenticated", // TEST ONLY Dont Need Authen
        "Match": { "Path": "/product-service/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/product-service" }
        ]
      },

      "swagger-product": {
        "ClusterId": "product-api",
        "Match": { "Path": "/swagger-json/product/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      }
    },

    "Clusters": {
      // ================= CUSTOMER =================
      "customer-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Path": "/health"
          }
        },
        "Destinations": {
          "customer-1": { "Address": "https://localhost:7224/" }
        }
      },

      // ================= PRODUCT =================
      "product-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Path": "/health"
          }
        },
        "Destinations": {
          "product-1": { "Address": "https://localhost:7031/" }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp.ReverseProxy": "Debug",
      "Microsoft.Extensions.Http": "Information"
    }
  },

  "SpaCors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type" ],
    "AllowCredentials": false
  }
}
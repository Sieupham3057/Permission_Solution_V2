{
  "ConnectionStrings": {
    "ConnectionStrings": "Data Source=127.0.0.1,1433;Initial Catalog=ProductDb;User id=sa;Password=Strong@Password123!; TrustServerCertificate=True"
  },

  "Authentication": {
    "RequireHttpsMetadata": false, // PROD RequireHttpsMetadata = true
    "Authority": "http://172.28.225.131:8080/realms/company-dev",
    "Audience": "product-api", // PROD sẽ set Audience = customer-api
    "MapInboundClaims": false,
    "ClockSkewSeconds": 0
  },

  "Keycloak": {
    "Realm": "company-dev",
    "ClientId": "angular-spa", // Phải là Client của FE nhé. vì FE mới là login chứ api thì không
    "NormalizePermissions": true
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type" ],
    "AllowCredentials": false
  }
}